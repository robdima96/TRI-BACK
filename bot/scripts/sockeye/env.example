# Copy to bot/.env on Sockeye (same directory as pyproject.toml).

# Replace YOURUSER with your Sockeye username (python-dotenv does not expand shell ${USER}).

# See app/config.py for all knobs.



# RAG sentence embeddings (Clinical_sBERT)

TRI_BACK_ENCODER_DIR=/scratch/YOURUSER/tri-back/models/Clinical_sBERT

TRI_BACK_RAG_EMBEDDING_BACKEND=sentence_transformers

TRI_BACK_ENCODER_DIM=768



# Span NER (GliNER-BioMed) — separate from RAG

TRI_BACK_GLINER_MODEL_DIR=/scratch/YOURUSER/tri-back/models/GliNER-BioMed

TRI_BACK_LOAD_NER=1

TRI_BACK_LOAD_GLINER=1



TRI_BACK_GENERATOR_DIR=/scratch/YOURUSER/tri-back/models/generator

# Generator: local | vertex (Gemini Flash on Vertex AI)
# Vertex user ADC (no service account key):
#   - Do NOT set GOOGLE_APPLICATION_CREDENTIALS
#   - gcloud auth application-default login
# TRI_BACK_GENERATOR_BACKEND=vertex
# TRI_BACK_GENERATOR_MODEL=gemini-3.5-flash-lite
# TRI_BACK_VERTEX_PROJECT_ID=your-gcp-project-id
# TRI_BACK_VERTEX_LOCATION=us



TRI_BACK_CHROMA_PATH=/scratch/YOURUSER/tri-back/chroma

TRI_BACK_CHECKPOINT_SQLITE=/scratch/YOURUSER/tri-back/langgraph_checkpoints.sqlite

TRI_BACK_SESSION_STORE_DIR=/scratch/YOURUSER/tri-back/sessions



TRI_BACK_LOAD_RAG=1



# Optional overrides

# TRI_BACK_GLINER_NER_THRESHOLD=0.35

# TRI_BACK_RAG_TOP_K=5

# TRI_BACK_ENCODER_MAX_LENGTH=256

# TRI_BACK_RAG_EMBEDDING_NORMALIZE=1

