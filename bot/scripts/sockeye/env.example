# Copy to bot/.env on Sockeye (same directory as pyproject.toml).

# Replace YOURUSER with your Sockeye username (python-dotenv does not expand shell ${USER}).

# See app/config.py for all knobs.



# RAG sentence embeddings (Clinical_sBERT)

DIGIMSK_ENCODER_DIR=/scratch/YOURUSER/digimsk/models/Clinical_sBERT

DIGIMSK_RAG_EMBEDDING_BACKEND=sentence_transformers

DIGIMSK_ENCODER_DIM=768



# Span NER (GliNER-BioMed) — separate from RAG

DIGIMSK_GLINER_MODEL_DIR=/scratch/YOURUSER/digimsk/models/GliNER-BioMed

DIGIMSK_LOAD_NER=1

DIGIMSK_LOAD_GLINER=1



DIGIMSK_GENERATOR_DIR=/scratch/YOURUSER/digimsk/models/generator

# Generator: local | vertex (Gemini Flash on Vertex AI)
# Vertex user ADC (no service account key):
#   - Do NOT set GOOGLE_APPLICATION_CREDENTIALS
#   - gcloud auth application-default login
# DIGIMSK_GENERATOR_BACKEND=vertex
# DIGIMSK_GENERATOR_MODEL=gemini-2.5-flash
# DIGIMSK_VERTEX_PROJECT_ID=your-gcp-project-id
# DIGIMSK_VERTEX_LOCATION=us-central1



DIGIMSK_CHROMA_PATH=/scratch/YOURUSER/digimsk/chroma

DIGIMSK_CHECKPOINT_SQLITE=/scratch/YOURUSER/digimsk/langgraph_checkpoints.sqlite

DIGIMSK_SESSION_STORE_DIR=/scratch/YOURUSER/digimsk/sessions



DIGIMSK_LOAD_RAG=1



# Optional overrides

# DIGIMSK_GLINER_NER_THRESHOLD=0.35

# DIGIMSK_RAG_TOP_K=5

# DIGIMSK_ENCODER_MAX_LENGTH=256

# DIGIMSK_RAG_EMBEDDING_NORMALIZE=1

