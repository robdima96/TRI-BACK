# TRI-BACK study (Reflex) for Cloud Run — single $PORT via Caddy + static export + backend.
# Build from TRI-BACK monorepo root:
#   docker build -f bot/app/services/public_host/cloud_run/Dockerfile.study \
#     --build-arg PUBLIC_BASE_URL=https://tri-back-study-XXXX.us-central1.run.app \
#     -t tri-back-study .
#
# After first deploy, rebuild with the printed study URL as PUBLIC_BASE_URL
# or WebSockets will still point at the old tri-back-study host.

FROM python:3.11-slim-bookworm

ARG PORT=8080
# Baked into the static frontend at export time (same-origin via Caddy after deploy).
ARG PUBLIC_BASE_URL=https://tri-back-study-PLACEHOLDER.us-central1.run.app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=${PORT} \
    TRI_BACK_PUBLIC_ACCESS=1 \
    TRI_BACK_PUBLIC_BASE_URL=${PUBLIC_BASE_URL} \
    API_URL=${PUBLIC_BASE_URL} \
    DEPLOY_URL=${PUBLIC_BASE_URL} \
    REFLEX_API_URL=${PUBLIC_BASE_URL} \
    REFLEX_REDIS_URL=redis://127.0.0.1:6379 \
    TRI_BACK_STUDY_DB=/mnt/tri-back/study/tri_back.db \
    TRI_BACK_BOT_API_KEY=build-placeholder \
    TRI_BACK_ADMIN_PASSWORD=build-placeholder

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    caddy \
    curl \
    redis-server \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /study

COPY prototypes/tri_back_study_app/requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY prototypes/tri_back_study_app/ ./
COPY bot/app/services/public_host/cloud_run/Caddyfile.study ./Caddyfile
COPY bot/app/services/public_host/cloud_run/scripts/entrypoint_study.sh /entrypoint_study.sh
RUN chmod +x /entrypoint_study.sh \
    && sed -i 's/\r$//' /entrypoint_study.sh

# Compile frontend (needs Node toolchain; Reflex installs bun/node as needed).
RUN reflex init \
    && reflex export --frontend-only --no-zip \
    && mkdir -p /srv \
    && mv .web/build/client/* /srv/ \
    && rm -rf .web

# Drop build-only secrets from the image env (runtime sets real values).
ENV TRI_BACK_BOT_API_KEY= \
    TRI_BACK_ADMIN_PASSWORD=

EXPOSE ${PORT}
STOPSIGNAL SIGKILL

CMD ["/entrypoint_study.sh"]
