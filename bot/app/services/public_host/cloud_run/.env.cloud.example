# Copy values into Cloud Run service env / Secret Manager.
# Project already used for Vertex:
# DIGIMSK_GCP_PROJECT=YOUR_GCP_PROJECT
# DIGIMSK_GCS_BUCKET=digimsk-cloudrun-YOUR_GCP_PROJECT

DIGIMSK_RAG=0
DIGIMSK_GRAPH_RAG=1
DIGIMSK_LOAD_RAG=0
DIGIMSK_GENERATOR_BACKEND=vertex
DIGIMSK_VERTEX_PROJECT_ID=YOUR_GCP_PROJECT
DIGIMSK_VERTEX_LOCATION=us-central1

# Paths on the GCS volume mount (/mnt/digimsk)
DIGIMSK_GLINER_MODEL_DIR=/mnt/digimsk/models/gliner
DIGIMSK_GRAPH_CSV=/mnt/digimsk/graph/v2/red_flags_manual_v2.csv
DIGIMSK_GRAPH_INVENTORY=/mnt/digimsk/graph/v2/inventory.json
DIGIMSK_SESSION_STORE_DIR=/mnt/digimsk/sessions

# SQLite over GCSFuse is unreliable; keep checkpoints local until max-instances policy is set
DIGIMSK_CHECKPOINT_SQLITE=/tmp/langgraph_checkpoints.sqlite

DIGIMSK_LOAD_GLINER=1
DIGIMSK_LOAD_NER=1

# Shared with study service (Secret Manager)
# DIGIMSK_BOT_API_KEY=
