# Overlay for the patient agent. Bot generator credentials live in bot/.env.
# Copy this file to .env and set only what you want to override.

# Same ADC + project as TRI-BACK generator (normally inherited from bot/.env):
# TRI_BACK_VERTEX_PROJECT_ID=
# TRI_BACK_VERTEX_LOCATION=us-central1
# TRI_BACK_GENERATOR_MODEL=gemini-2.5-flash

# Switch the *patient* Vertex model without changing TRI-BACK's generator:
# PATIENT_VERTEX_MODEL=gemini-2.0-flash

# TRI_BACK_BOT_URL=http://127.0.0.1:8001
# TRI_BACK_BOT_API_KEY=
