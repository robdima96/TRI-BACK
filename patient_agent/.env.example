# Overlay for the patient agent. Bot generator credentials live in bot/.env.
# Copy this file to .env and set only what you want to override.

# Same ADC + project as DigiMSKbot generator (normally inherited from bot/.env):
# DIGIMSK_VERTEX_PROJECT_ID=
# DIGIMSK_VERTEX_LOCATION=us-central1
# DIGIMSK_GENERATOR_MODEL=gemini-2.5-flash

# Switch the *patient* Vertex model without changing DigiMSK's generator:
# PATIENT_VERTEX_MODEL=gemini-2.0-flash

# DIGIMSK_BOT_URL=http://127.0.0.1:8001
# DIGIMSK_BOT_API_KEY=
