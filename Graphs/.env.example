# Copy to .env and fill in your Neo4j Aura (or Desktop) credentials.
# Or run: python setup_connection.py

# Aura (from console.neo4j.io -> instance -> Connect):
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
# Leave blank on Aura to auto-detect from URI (instance id). Use neo4j for Desktop.
NEO4J_DATABASE=

# Neo4j Desktop (local):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-desktop-password
# NEO4J_DATABASE=neo4j

RED_FLAGS_CSV=bot/Knowledge Base/Red Flags/chunks/manual/red_flags_manual_failsafe.csv
