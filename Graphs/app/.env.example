# App password (required) — users enter this on the login page
APP_PASSWORD=change-me

# Session signing secret (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Server port
PORT=3847

# Neo4j credentials are read from ../.env (Graphs/.env) by default.
# Override here if needed:
# NEO4J_URI=
# NEO4J_USERNAME=
# NEO4J_PASSWORD=
# NEO4J_DATABASE=
