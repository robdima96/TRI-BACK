# Copy to bot/.env on Sockeye (same directory as pyproject.toml).
# Replace YOURUSER with your Sockeye username (python-dotenv does not expand shell ${USER}).
# See app/config.py for all knobs.

DIGIMSK_ENCODER_DIR=/scratch/YOURUSER/digimsk/models/encoder
DIGIMSK_GENERATOR_DIR=/scratch/YOURUSER/digimsk/models/generator

DIGIMSK_CHROMA_PATH=/scratch/YOURUSER/digimsk/chroma
DIGIMSK_CHECKPOINT_SQLITE=/scratch/YOURUSER/digimsk/langgraph_checkpoints.sqlite
DIGIMSK_SESSION_STORE_DIR=/scratch/YOURUSER/digimsk/sessions

DIGIMSK_LOAD_RAG=1
DIGIMSK_LOAD_NER=0

# Optional overrides
# DIGIMSK_RAG_TOP_K=5
# DIGIMSK_ENCODER_DIM=768
# DIGIMSK_ENCODER_MAX_LENGTH=256
