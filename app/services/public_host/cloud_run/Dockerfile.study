# DigiMSK study (Reflex) image — build context must include prototypes/digimsk_study_app.
#
# The study UI lives OUTSIDE the bot git repo today:
#   DigiMSKbot/bot/          <- this git repo
#   DigiMSKbot/prototypes/digimsk_study_app/
#
# Build from the DigiMSKbot workspace root (parent of bot/), not from bot/:
#   docker build -f bot/app/services/public_host/cloud_run/Dockerfile.study -t digimsk-study .
#
# Or copy/vend the study app into this repo under study_app/ and adjust COPY paths.
# See STUDY_SERVICE.md for the full finish checklist.

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DIGIMSK_PUBLIC_ACCESS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /study

COPY prototypes/digimsk_study_app/requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY prototypes/digimsk_study_app/ ./

# Production entry: Caddy (or similar) must listen on $PORT and reverse-proxy
# Reflex frontend + /_event WebSocket. Placeholder until wired — see STUDY_SERVICE.md.
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "echo 'Study Cloud Run entry not finished — see cloud_run/STUDY_SERVICE.md'; exit 1"]
