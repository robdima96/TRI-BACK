# Copy to .env and adjust as needed.

# Bot API (FastAPI) — use 8001 so Reflex backend can own port 8000.
CHATBOT_BASE_URL=http://127.0.0.1:8001

# Optional: same value as bot TRI_BACK_BOT_API_KEY (required when TRI_BACK_PUBLIC_ACCESS=1).
# TRI_BACK_BOT_API_KEY=

# Required. Admin login username is admin.
# TRI_BACK_ADMIN_PASSWORD=

# Session JSON directory (must match the bot TRI_BACK_SESSION_STORE_DIR).
# TRI_BACK_SESSIONS_DIR=

# Optional public share link — see bot/app/services/public_host/README.md
# TRI_BACK_PUBLIC_ACCESS=0
# Hosted UI uses the page origin for WebSockets; do not set a baked API_URL.
# TRI_BACK_SHARE_TOKEN=

# Optional: canned chat intro (study-only; not sent to the bot).
# TRI_BACK_INTRO_DELAY_SEC=10
# TRI_BACK_INTRO_MESSAGE=Hi, I'm TRI-BACK. I understand you have low back pain — I'm here to help rule out any concerning patterns. ...
