# Copy to .env and adjust as needed.

# Bot API (FastAPI) — use 8001 so Reflex backend can own port 8000.

CHATBOT_BASE_URL=http://127.0.0.1:8001



# Optional: same value as bot DIGIMSK_BOT_API_KEY (required when DIGIMSK_PUBLIC_ACCESS=1).

# DIGIMSK_BOT_API_KEY=



# Admin password (required when DIGIMSK_PUBLIC_ACCESS=1; local fallback is digimsk).

# DIGIMSK_ADMIN_PASSWORD=



# Optional public share link — see bot/app/services/public_host/README.md

# DIGIMSK_PUBLIC_ACCESS=0

# DIGIMSK_PUBLIC_BASE_URL=

# DIGIMSK_SHARE_TOKEN=


